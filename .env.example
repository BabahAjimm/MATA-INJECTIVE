# Copy to .env and never commit real values.
# Verify all endpoints against docs.injective.network before use.

# Injective EVM JSON-RPC (testnet chain id 1439, mainnet 1776; verify)
INJ_EVM_RPC_URL=
# Injective indexer / chain stream endpoint (for native module events)
INJ_INDEXER_URL=

# Optional: LLM provider for AI triage (only called for flagged events)
LLM_API_KEY=

# Optional: Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
